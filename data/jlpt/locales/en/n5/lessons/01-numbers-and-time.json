{
  "one-to-five": {
    "title": "One to five",
    "summary": "The first five numerals. Each one carries two readings — 一 is いち when counting and ひと when counting things — and the only way to fix that is to meet both.",
    "words": {
      "一つ|ひとつ": ["One Thing"],
      "一人|ひとり": ["One Person", "Alone"],
      "一日|ついたち": ["First of the Month"],
      "一月|いちがつ": ["January"],
      "一番|いちばん": ["The Most", "Number One"],

      "二つ|ふたつ": ["Two Things"],
      "二人|ふたり": ["Two People"],
      "二日|ふつか": ["Second of the Month", "Two Days"],
      "二月|にがつ": ["February"],
      "十二|じゅうに": ["Twelve"],

      "三つ|みっつ": ["Three Things"],
      "三人|さんにん": ["Three People"],
      "三日|みっか": ["Third of the Month", "Three Days"],
      "三月|さんがつ": ["March"],
      "三時|さんじ": ["Three O'clock"],

      "四つ|よっつ": ["Four Things"],
      "四人|よにん": ["Four People"],
      "四日|よっか": ["Fourth of the Month", "Four Days"],
      "四月|しがつ": ["April"],
      "四時|よじ": ["Four O'clock"],

      "五つ|いつつ": ["Five Things"],
      "五人|ごにん": ["Five People"],
      "五日|いつか": ["Fifth of the Month", "Five Days"],
      "五月|ごがつ": ["May"],
      "五時|ごじ": ["Five O'clock"]
    }
  },
