  "running-and-stopping": {
    "title": "Running and stopping",
    "summary": "走る looks like an ichidan verb but is godan: 走って, never 走て. 起 gives three verbs to keep apart — 起きる you get up, 起こす you wake someone or cause something, 起こる something happens.",
    "words": {
      "走る|はしる": ["To Run"],
