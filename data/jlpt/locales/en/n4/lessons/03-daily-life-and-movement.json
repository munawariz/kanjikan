{
  "buying-and-lending": {
    "title": "Buying, selling, lending",
    "summary": "貸す and 借りる both start with か and are easy to swap: 貸す is lending something out, 借りる is borrowing it in. 売 and 買 share the on reading ばい, so 売買, buying and selling, is ばいばい.",
    "words": {
      "売る|うる": ["To Sell"],
      "売れる|うれる": ["To Sell Well", "To Be Sold"],
      "売り場|うりば": ["Sales Floor", "Counter"],
      "売店|ばいてん": ["Kiosk", "Stall"],
      "売り手|うりて": ["Seller"],
      "商売|しょうばい": ["Business", "Trade"],

      "買う|かう": ["To Buy"],
      "買い手|かいて": ["Buyer"],
      "売買|ばいばい": ["Buying and Selling"],
