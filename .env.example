# ---------------------------------------------------------------------------
# The database. Used by the app at runtime and by `npm run migrate`.
# Server-side only: it is never sent to the browser. Keep it secret.
#
# Get it from the Connect button at the top of the Supabase dashboard, under
# ORMs or Connection string, and copy the URI.
#
# Prefer the Session pooler URI. The direct db.<ref>.supabase.co host is
# IPv6-only on newer projects and will fail to connect from most networks.
# ---------------------------------------------------------------------------
SUPABASE_DB_URL=postgresql://postgres.your-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres
