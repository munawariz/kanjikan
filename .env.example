# ---------------------------------------------------------------------------
# App credentials. Project Settings > API in the Supabase dashboard.
# Safe to expose: these are the browser-side keys, and Row Level Security is
# what actually protects the data.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key

# ---------------------------------------------------------------------------
# Migrations only, used by `npm run migrate`. Never sent to the browser.
#
# This is NOT the URL above. Get it from the Connect button at the top of the
# dashboard, under ORMs or Connection string, and copy the URI.
#
# Prefer the Session pooler URI. The direct db.<ref>.supabase.co host is
# IPv6-only on newer projects and will fail to connect from most networks.
# ---------------------------------------------------------------------------
SUPABASE_DB_URL=postgresql://postgres.your-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres
